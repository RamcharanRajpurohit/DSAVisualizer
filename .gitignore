# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# legacy rails app (kept for reference)
/legacy-rails/log/*
/legacy-rails/tmp/*
/legacy-rails/storage/*
/legacy-rails/config/master.key
/legacy-rails/.bundle
/legacy-rails/public/assets

# local browser-automation artifacts
/.playwright-mcp/
